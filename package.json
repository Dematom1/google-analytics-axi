{
  "name": "search-console-axi",
  "version": "0.1.0",
  "description": "Read-only Google Search Console CLI for agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "search-console-axi": "./dist/bin/search-console-axi.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "skills/search-console-axi",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test test/cli.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "axi-sdk-js": "0.1.13",
    "google-auth-library": "^11.3.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
